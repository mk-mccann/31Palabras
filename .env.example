# Copy to .env. Everything here is optional.

# DeepL API key (free tier: https://www.deepl.com/pro-api). When set, an Ask DeepL
# button appears beside translations. It never runs by itself.
DEEPL_API_KEY=

# Where 31 Minutos lives, if you have no series.json. To add more series, copy
# series.example.json to series.json instead.
SHOW_ROOT=/Volumes/mccann_ssd/31 minutos

# How many episodes to keep ready to play (about 280 MB each for 31 Minutos).
MEDIA_CACHE_EPISODES=5
